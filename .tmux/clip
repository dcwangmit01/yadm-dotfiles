#!/bin/sh
# tmux copy-pipe target: forward stdin to whichever local clipboard tool exists.
# tmux also emits OSC 52 itself (set-clipboard on), so with no tool this is a no-op
# and the *local* terminal (even over ssh) still receives the selection.
if   command -v pbcopy  >/dev/null 2>&1; then exec pbcopy
elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then exec wl-copy
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then exec xclip -selection clipboard
elif [ -n "${DISPLAY:-}" ] && command -v xsel  >/dev/null 2>&1; then exec xsel --clipboard --input
else cat >/dev/null
fi
