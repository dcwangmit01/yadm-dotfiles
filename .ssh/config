#######################################
# Global Configs
# Keepalive, prevents closing of connection
ServerAliveInterval 60
ForwardAgent yes
ForwardX11 yes
ForwardX11Trusted yes

# Machine-local, git-ignored (agents, colima, …). MUST stay above the first
# Host block: an Include after a Host/Match line is conditionally processed
# inside that block's context (man ssh_config) and would only be read for
# matching hosts.
Include ~/.ssh/config.local

#######################################
# Hosts

Host homeassistant.local
    HostName 192.168.82.11
    # Key is filed in known_hosts under the name, not the IP; keep lookups
    # there so a future IP change doesn't trip host key verification.
    HostKeyAlias homeassistant.local
